# Copy this file to .env and fill in the keys you need.
# .env is gitignored and loaded automatically (via python-dotenv) whenever
# acclaim is imported. Config YAML files reference these as ${VAR_NAME}.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Optional: Keenable web search for the explorer (keyless public endpoint when unset)
KEENABLE_API_KEY=
